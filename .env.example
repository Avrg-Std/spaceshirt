AIRTABLE_TOKEN=pat_your_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Products
AIRTABLE_ORDERS_TABLE_NAME=Customer Orders

# Admin Panel
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_random_32_char_secret_minimum

# Cloudinary (product image uploads in admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=spaceshirt/products

# Airtable Products table — optional curation fields for homepage (Phase 5)
# Featured (checkbox), Featured Order (number), Show on Newest (checkbox), Newest Order (number)
AIRTABLE_SIZE_INVENTORY_TABLE_NAME=Size Inventory
AIRTABLE_SETTINGS_TABLE_NAME=App Settings

# Whish Pay (never commit real channel/secret)
# WHISH_ENVIRONMENT=mock keeps the local mock checkout page
# sandbox | production is the env fallback; admin Payments can override at runtime
WHISH_CHANNEL=your_whish_channel
WHISH_SECRET=your_whish_secret
WEBSITE_URL=https://ciao-lu.com
WHISH_ENVIRONMENT=sandbox
WHISH_USER_AGENT=CiaoLu/1.0 (https://ciao-lu.com; hello@ciao-lu.com)
